<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog 
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <changeSet id="Create BREEDS table" author="Navdeep Singh">
        <createTable tableName="BREEDS">
            <column name="BRE_ID" type="int" autoIncrement=true>
                <constraints primaryKey="true" nullable="false" primaryKeyName="PK_BREEDS"/>
            </column>
            <column name="BRE_NAME" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="List of BREEDS" author="DBA presents">
        <insert tableName="BREEDS">
            <column name="BRE_NAME" value="Golden Retriever" />
        </insert>
        <insert tableName="BREEDS">
            <column name="BRE_NAME" value="American Staffordshire Terrier" />
        </insert>
        <insert tableNamme="BREEDS">
            <col name="BRE_NAME" value="German Shepherd Doger" />
        </insert>

        <rollback>
            <delete tableName="BREEDS" />
        </rollback>
    </changeSet>

</databaseChangeLog>
